# ─── Umum ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_NAME=Malawali Payment
SUPPORT_URL=https://t.me/malawali_payment_bot

# ─── Sumber data ─────────────────────────────────────────────────────────
# mock = pakai data dummy (fase UI, tidak butuh MongoDB)
# db   = pakai MongoDB
DATA_SOURCE=mock

# ─── Database ────────────────────────────────────────────────────────────
# Kalau DEVELOPMENT_MONGO_MEMORY=true, MongoDB in-memory dinyalakan otomatis
# dan MONGODB_URI diabaikan selama development.
DEVELOPMENT_MONGO_MEMORY=true
MONGODB_URI=mongodb://127.0.0.1:27017/malawali

# ─── Session ─────────────────────────────────────────────────────────────
SESSION_SECRET=ganti-dengan-string-acak-panjang
SESSION_NAME=malawali.sid
SESSION_TTL_DAYS=7
# mongo (default saat DATA_SOURCE=db) | memory (khusus test, tanpa session store)
SESSION_DRIVER=mongo

# ─── Cloudflare Turnstile ────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true = lewati verifikasi (hanya untuk development)
TURNSTILE_DISABLED=true

# ─── Google OAuth (opsional) ─────────────────────────────────────────────
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email ───────────────────────────────────────────────────────────────
# console = cukup cetak email ke terminal (development)
MAIL_TRANSPORT=console
MAIL_FROM=Malawali Payment <no-reply@malawalipayment.web.id>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Kriptografi ─────────────────────────────────────────────────────────
# 32-byte hex (64 karakter) untuk AES-256-GCM kredensial provider
CREDENTIAL_ENC_KEY=
# 32-byte hex untuk hash API key
API_KEY_PEPPER=

# ─── Order & webhook ─────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=3
ORDER_EXPIRE_SWEEP_SECONDS=30

# ─── Provider ────────────────────────────────────────────────────────────
# mock = adapter palsu (aman untuk development)
PROVIDER_ADAPTER=mock

# ─── Harga langganan (rupiah) ────────────────────────────────────────────
PLAN_PRICE_1=10000
PLAN_PRICE_2=20000
PLAN_PRICE_3=30000
PLAN_PRICE_5=40000
