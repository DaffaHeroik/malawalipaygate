<% if (done) { %>
  <div class="auth-title">
    <h1>Password diperbarui</h1>
    <p>Password akun Anda sudah diganti. Silakan masuk memakai password baru.</p>
  </div>
  <a class="btn btn--primary btn--block btn--lg" href="/login">Masuk</a>
<% } else { %>
  <div class="auth-title">
    <h1>Reset Password</h1>
    <p>Buat password baru untuk akun Anda.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert--danger">
      <%- include('../../partials/icon', { name: 'alert' }) %>
      <div class="alert__body"><%= error %></div>
    </div>
  <% } %>

  <form method="post" action="/reset-password/<%= token %>" class="stack" data-submit-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label class="field">
      <span class="field__label">Password Baru</span>
      <input class="input" type="password" id="new-password" name="password" required autocomplete="new-password" minlength="8">
      <span class="progress" data-password-strength="#new-password"><span class="progress__bar" style="width:0"></span></span>
      <span class="field__hint" data-password-hint>Minimal 8 karakter, memuat huruf dan angka.</span>
    </label>

    <label class="field">
      <span class="field__label">Konfirmasi Password Baru</span>
      <input class="input" type="password" name="password_confirm" required autocomplete="new-password" minlength="8" data-password-match="#new-password" data-target="#confirm-error">
      <span class="field__error" id="confirm-error"></span>
    </label>

    <button class="btn btn--primary btn--block btn--lg" type="submit">Simpan Password Baru</button>
  </form>

  <div class="auth-links">
    <a href="/login">Kembali ke halaman masuk</a>
  </div>
<% } %>
