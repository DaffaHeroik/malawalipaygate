<div class="auth-title">
  <h1>Lupa Password</h1>
  <p>Masukkan email akun. Kami kirim tautan untuk membuat password baru.</p>
</div>

<% if (error) { %>
  <div class="alert alert--danger">
    <%- include('../../partials/icon', { name: 'alert' }) %>
    <div class="alert__body"><%= error %></div>
  </div>
<% } %>

<% if (sent) { %>
  <div class="alert alert--success">
    <%- include('../../partials/icon', { name: 'checkCircle' }) %>
    <div class="alert__body">
      <span class="alert__title">Tautan terkirim</span>
      Kalau email <strong><%= email %></strong> terdaftar, tautan reset sudah dikirim. Tautan berlaku terbatas.
    </div>
  </div>
<% } %>

<form method="post" action="/forgot-password" class="stack" data-submit-once>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <label class="field">
    <span class="field__label">Email</span>
    <input class="input" type="email" name="email" value="<%= email %>" placeholder="nama@email.com" required autocomplete="email" maxlength="254">
  </label>

  <button class="btn btn--primary btn--block btn--lg" type="submit">Kirim Tautan Reset</button>
</form>

<div class="auth-links">
  <a href="/login">Kembali ke halaman masuk</a>
</div>
