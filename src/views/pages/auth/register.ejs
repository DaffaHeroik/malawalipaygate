<% if (sent) { %>
  <div class="auth-title">
    <h1>Cek email Anda</h1>
    <p>Kami mengirim kode verifikasi ke <strong><%= email %></strong>.</p>
  </div>

  <div class="alert alert--success">
    <%- include('../../partials/icon', { name: 'checkCircle' }) %>
    <div class="alert__body">
      <span class="alert__title">Akun dibuat</span>
      Buka tautan verifikasi di email untuk mengaktifkan akun, lalu masuk ke dashboard.
    </div>
  </div>

  <a class="btn btn--primary btn--block" href="/login">Ke halaman masuk</a>
<% } else { %>
  <div class="auth-title">
    <h1>Daftar</h1>
    <p>Buat akun <%= brand.name %> dengan email aktif.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert--danger">
      <%- include('../../partials/icon', { name: 'alert' }) %>
      <div class="alert__body"><%= error %></div>
    </div>
  <% } %>

  <% if (googleEnabled) { %>
    <a class="btn-google" href="/auth/google?intent=register" rel="nofollow">
      <svg viewBox="0 0 18 18" aria-hidden="true">
        <path fill="#4285F4" d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.482h4.844a4.14 4.14 0 0 1-1.797 2.716v2.258h2.909c1.702-1.567 2.684-3.874 2.684-6.615Z"/>
        <path fill="#34A853" d="M9 18c2.43 0 4.468-.806 5.956-2.18l-2.909-2.258c-.806.54-1.835.859-3.047.859-2.344 0-4.328-1.585-5.037-3.714H.956v2.332A9 9 0 0 0 9 18Z"/>
        <path fill="#FBBC05" d="M3.963 10.707A5.41 5.41 0 0 1 3.682 9c0-.592.102-1.167.281-1.707V4.961H.956A9 9 0 0 0 0 9c0 1.452.347 2.827.956 4.039l3.007-2.332Z"/>
        <path fill="#EA4335" d="M9 3.579c1.322 0 2.508.454 3.441 1.346l2.581-2.581C13.464.892 11.426 0 9 0A9 9 0 0 0 .956 4.961l3.007 2.332C4.672 5.164 6.656 3.579 9 3.579Z"/>
      </svg>
      <span>Daftar dengan Google</span>
    </a>
    <div class="auth-divider">atau daftar dengan email</div>
  <% } %>

  <form method="post" action="/register" class="stack" data-submit-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label class="field">
      <span class="field__label">Email</span>
      <input class="input" type="email" name="email" value="<%= email %>" placeholder="nama@email.com" required autocomplete="email" maxlength="254">
    </label>

    <label class="field">
      <span class="field__label">Password</span>
      <input class="input" type="password" name="password" placeholder="Minimal 8 karakter" required autocomplete="new-password" minlength="8">
      <span class="field__hint">Minimal 8 karakter, memuat huruf dan angka.</span>
    </label>

    <% if (turnstileEnabled) { %>
      <div class="turnstile-wrap">
        <div
          class="cf-turnstile"
          data-sitekey="<%= turnstileSiteKey %>"
          data-action="register"
          data-size="flexible"
          data-theme="auto"
          data-callback="malawaliTurnstileSuccess"
          data-expired-callback="malawaliTurnstileExpired"
          data-error-callback="malawaliTurnstileError"
        ></div>
      </div>
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      <script nonce="<%= cspNonce %>">
        (() => {
          const btn = document.getElementById('register-submit');
          const setState = (ok) => {
            if (!btn) return;
            btn.disabled = !ok;
            btn.textContent = ok ? 'Daftar & Kirim Kode' : 'Verifikasi ulang...';
          };
          window.malawaliTurnstileSuccess = () => setState(true);
          window.malawaliTurnstileExpired = () => setState(false);
          window.malawaliTurnstileError = () => setState(false);
          setState(false);
        })();
      </script>
    <% } %>

    <button
      class="btn btn--primary btn--block btn--lg"
      id="register-submit"
      type="submit"
      <%= turnstileEnabled ? 'disabled' : '' %>
    >Daftar &amp; Kirim Kode</button>
  </form>

  <div class="auth-links">
    <span class="muted text-sm">Sudah punya akun? <a href="/login">Masuk</a></span>
  </div>
<% } %>
