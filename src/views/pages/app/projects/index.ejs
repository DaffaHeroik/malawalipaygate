<div class="page-header">
  <div>
    <span class="page-header__eyebrow">Project Monitoring</span>
    <h1>Projects</h1>
    <p class="page-header__sub">Pantau transaksi setiap website, bot, atau aplikasi dari satu tempat.</p>
  </div>
  <div class="page-header__actions">
    <button class="btn btn--primary" type="button" data-modal-open="modal-create-project">
      <%- include('../../../partials/icon', { name: 'plus' }) %>
      <span>Buat Project</span>
    </button>
  </div>
</div>

<section class="metric-grid">
  <article class="metric">
    <div class="metric__top">
      <span class="metric__label">Project</span>
      <span class="metric__icon"><%- include('../../../partials/icon', { name: 'projects' }) %></span>
    </div>
    <div>
      <div class="metric__value"><%= aggregate.projects %></div>
      <span class="metric__sub">Project aktif</span>
    </div>
  </article>

  <article class="metric">
    <div class="metric__top">
      <span class="metric__label">Transaksi</span>
      <span class="metric__icon"><%- include('../../../partials/icon', { name: 'list' }) %></span>
    </div>
    <div>
      <div class="metric__value"><%= helpers.formatNumber(aggregate.transactions) %></div>
      <span class="metric__sub">Semua order</span>
    </div>
  </article>

  <article class="metric metric--paid">
    <div class="metric__top">
      <span class="metric__label">Paid</span>
      <span class="metric__icon"><%- include('../../../partials/icon', { name: 'check' }) %></span>
    </div>
    <div>
      <div class="metric__value"><%= helpers.formatNumber(aggregate.paid) %></div>
      <span class="metric__sub">Order berhasil</span>
    </div>
  </article>

  <article class="metric metric--cancelled">
    <div class="metric__top">
      <span class="metric__label">Volume Paid</span>
      <span class="metric__icon"><%- include('../../../partials/icon', { name: 'chart' }) %></span>
    </div>
    <div>
      <div class="metric__value metric__value--money"><%= helpers.formatRupiah(aggregate.volume) %></div>
      <span class="metric__sub">Total revenue</span>
    </div>
  </article>
</section>

<section class="project-grid">
  <% projects.forEach((project) => { %>
    <article class="project-card">
      <div class="project-card__head">
        <div>
          <div class="project-card__title">
            <span class="avatar avatar--soft" style="width:32px;height:32px;font-size:13px">
              <%= helpers.initials(project.name) %>
            </span>
            <span><%= project.name %></span>
          </div>
          <span class="muted text-xs" style="display:block;margin-top:6px">
            <%= project.lastActivityAt ? `Aktivitas terakhir ${helpers.formatDateTime(project.lastActivityAt)}` : 'Belum ada aktivitas' %>
          </span>
        </div>
        <% if (project.isDefault) { %>
          <span class="badge badge--primary">Utama</span>
        <% } %>
      </div>

      <div class="project-stats">
        <div>
          <span class="project-stat__label">Transaksi</span>
          <span class="project-stat__value"><%= helpers.formatNumber(project.stats.total) %></span>
        </div>
        <div>
          <span class="project-stat__label">Paid</span>
          <span class="project-stat__value"><%= helpers.formatNumber(project.stats.paid) %></span>
        </div>
        <div>
          <span class="project-stat__label">Pending</span>
          <span class="project-stat__value"><%= helpers.formatNumber(project.stats.pending) %></span>
        </div>
        <div>
          <span class="project-stat__label">Volume</span>
          <span class="project-stat__value"><%= helpers.formatRupiah(project.stats.volume) %></span>
        </div>
      </div>

      <div class="row row-tight">
        <button
          class="btn btn--secondary btn--sm"
          type="button"
          data-modal-open="modal-rename-<%= project.id %>"
        >
          <%- include('../../../partials/icon', { name: 'pencil' }) %>
          <span>Edit Nama</span>
        </button>

        <a class="btn btn--soft-primary btn--sm" href="/settings?tab=api-key">
          <span>Buka Project</span>
          <%- include('../../../partials/icon', { name: 'chevronRight' }) %>
        </a>

        <% if (!project.isDefault) { %>
          <button
            class="btn btn--ghost btn--sm ml-auto"
            type="button"
            data-modal-open="modal-delete-<%= project.id %>"
            aria-label="Hapus project <%= project.name %>"
          >
            <%- include('../../../partials/icon', { name: 'trash' }) %>
            <span>Hapus</span>
          </button>
        <% } %>
      </div>
    </article>

    <%# ── Modal edit nama ── %>
    <div class="modal" id="modal-rename-<%= project.id %>" hidden>
      <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="rename-title-<%= project.id %>">
        <div class="modal__head">
          <div>
            <h2 id="rename-title-<%= project.id %>">Edit Nama Project</h2>
            <p>Ubah label project tanpa mengubah transaksi atau konfigurasi integrasi.</p>
          </div>
          <button class="modal__close" type="button" data-modal-close aria-label="Tutup">
            <%- include('../../../partials/icon', { name: 'close' }) %>
          </button>
        </div>

        <form method="post" action="/projects/<%= project.id %>/rename">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal__body">
            <label class="field">
              <span class="field__label">Nama Project</span>
              <input class="input" type="text" name="name" value="<%= project.name %>" maxlength="60" required>
            </label>
          </div>
          <div class="modal__foot">
            <button class="btn btn--secondary" type="button" data-modal-close>Batal</button>
            <button class="btn btn--primary" type="submit">Simpan Perubahan</button>
          </div>
        </form>
      </div>
    </div>

    <%# ── Modal hapus ── %>
    <% if (!project.isDefault) { %>
      <div class="modal" id="modal-delete-<%= project.id %>" hidden>
        <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="delete-title-<%= project.id %>">
          <div class="modal__head">
            <div>
              <h2 id="delete-title-<%= project.id %>">Hapus Project</h2>
              <p>Masukkan password akun untuk mengonfirmasi penghapusan project.</p>
            </div>
            <button class="modal__close" type="button" data-modal-close aria-label="Tutup">
              <%- include('../../../partials/icon', { name: 'close' }) %>
            </button>
          </div>

          <form method="post" action="/projects/<%= project.id %>/delete" data-submit-once>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="modal__body">
              <div class="alert alert--danger">
                <%- include('../../../partials/icon', { name: 'alert' }) %>
                <div class="alert__body">
                  <span class="alert__title">Project akan dihapus</span>
                  API key project ini dicabut. Riwayat transaksi yang sudah selesai tetap disimpan dan
                  dipindahkan ke Project Utama. Project dengan transaksi PENDING tidak dapat dihapus.
                </div>
              </div>

              <label class="field">
                <span class="field__label">Password Akun <span class="req">*</span></span>
                <input class="input" type="password" name="password" required autocomplete="current-password">
              </label>
            </div>
            <div class="modal__foot">
              <button class="btn btn--secondary" type="button" data-modal-close>Batal</button>
              <button class="btn btn--danger" type="submit">Hapus Project</button>
            </div>
          </form>
        </div>
      </div>
    <% } %>
  <% }) %>
</section>

<%# ── Modal buat project ── %>
<div class="modal" id="modal-create-project" hidden>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="create-project-title">
    <div class="modal__head">
      <div>
        <h2 id="create-project-title">Buat Project</h2>
        <p>Tambahkan ruang monitoring baru. Identitas project dibuat otomatis oleh <%= brand.name %>.</p>
      </div>
      <button class="modal__close" type="button" data-modal-close aria-label="Tutup">
        <%- include('../../../partials/icon', { name: 'close' }) %>
      </button>
    </div>

    <form method="post" action="/projects">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal__body">
        <label class="field">
          <span class="field__label">Nama Project <span class="req">*</span></span>
          <input class="input" type="text" name="name" placeholder="Contoh: Bot Telegram" maxlength="60" required>
          <span class="field__hint">Nama ini hanya menjadi label pada monitoring dan riwayat transaksi.</span>
        </label>
      </div>
      <div class="modal__foot">
        <button class="btn btn--secondary" type="button" data-modal-close>Batal</button>
        <button class="btn btn--primary" type="submit">Simpan Project</button>
      </div>
    </form>
  </div>
</div>
